# Mith Hera Call Assistant server v2 — copy to .env locally, or set
# these as environment variables in Render. NEVER commit a real .env
# file. No secret is ever baked into the code or the repo.
# All AI is Bengali-first (bn-IN). With NO keys set the server still
# works: browser STT/TTS (bn-IN) + scripted Bengali replies.

# Public URL of the deployed server (Render gives it after deploy).
BASE_URL=https://mith-hera-call-server.onrender.com

# Gemini brain (Google AI Studio key). Required for smart replies.
# System prompt is Bengali; model chain gemini-3.5-flash ->
# gemini-3.5-flash-lite -> gemini-flash-latest.
GEMINI_API_KEY=

# Google Cloud key with Speech-to-Text + Text-to-Speech enabled.
# (An AI Studio key does NOT work here.) If empty, the WebRTC page uses
# the caller's browser speech recognition + speech synthesis instead.
GOOGLE_API_KEY=

# Sarvam AI (Bengali-first STT + TTS). Saarika STT (bn-IN) is tried
# FIRST, Bulbul TTS (Bengali voice) is tried FIRST — Google is the
# fallback for both. Dograh lists saarika:v2.5 / saaras:v3 and
# bulbul:v3 / bulbul:v4-flash; defaults below match this server's
# REST API shape. Bengali voices include roopa_bn_conversational
# and arnab_bn_conversation (set via SARVAM_SPEAKER with bulbul:v4-flash).
SARVAM_API_KEY=
SARVAM_SPEAKER=roopa
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_STT_LANGUAGE=bn-IN

# Supabase (recording + transcript storage for CHATS history).
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=call-recordings

# Owner's phone, E.164. Transfer target ONLY when the caller asks.
OWNER_PHONE=

# Transfer wait (seconds) before the AI says the owner is busy.
TRANSFER_WAIT_SECONDS=30

# OPTIONAL provider adapter (Plivo). OFF by default — leave unset.
# Plivo is the cheapest India path (number ~₹200/mo + ₹0.38/min,
# business KYC needed) — attach ONLY if the user ever approves it.
ENABLE_PLIVO=false
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_NUMBER=
